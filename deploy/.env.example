# Point this domain's DNS A record at the Linux server before starting.
DASHBOARD_DOMAIN=ambulance.example.com
DASHBOARD_USER=researcher
# Generate using: docker run --rm -it caddy:2-alpine caddy hash-password
# Keep the hash in SINGLE quotes so Docker Compose preserves all dollar signs.
DASHBOARD_PASSWORD_HASH='REPLACE_WITH_CADDY_PASSWORD_HASH'
APP_CPUS=2
APP_MEMORY_LIMIT=6g
